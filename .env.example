# Quant Zifang（張良）後端環境變數範例
# 複製為 .env 後依需求調整；系統環境變數優先於 .env 檔案。
# 所有變數皆支援加上 ZIFANG_* 前綴作為別名（例如 ZIFANG_DATA_DIR）。

# 執行環境：dev | prod
ENV=dev

# 日誌層級：DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# JSON 資料與快取目錄（相對於執行目錄或絕對路徑）
DATA_DIR=data

# 允許的 CORS 來源（逗號分隔，須為 http(s)://host[:port]，不可含路徑、結尾斜線或萬用字元 *）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000
